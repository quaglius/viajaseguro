# Credenciales del Agente Emisor de Cardinal Assistance (Evoucher 2 API)
# Nunca commitear el .env real — este es solo el ejemplo.
# El secreto es obligatorio para poder emitir vouchers (/emitir).
CARDINAL_API_BASE=https://evoucher.cardinalassistance.com/webservice
CARDINAL_AGENTE_GUID=reemplazar_con_guid_real
CARDINAL_AGENTE_SECRETO=reemplazar_con_secreto_real

# Access token de Mercado Pago (cuenta del vendedor). Se usa server-side para
# crear la preferencia de pago — nunca se expone al browser.
MP_ACCESS_TOKEN=reemplazar_con_access_token_real

# URL pública del sitio (para armar las back_urls y el notification_url que
# le pasamos a Mercado Pago). En local dejalo en localhost.
SITE_URL=http://localhost:3000

# Puerto del servidor local
PORT=3000

# GA4 — Measurement ID de la propiedad de Google Analytics 4
# (se inyecta en el HTML server-side, no hardcodeado en el front)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
